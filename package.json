{
  "name": "sdet-automation-challenge",
  "version": "1.0.0",
  "description": "A robust test automation suite demonstrating end-to-end UI and REST API testing using Playwright and TypeScript.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/froilanfulgencio/sdet-automation-challenge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/froilanfulgencio/sdet-automation-challenge/issues"
  },
  "homepage": "https://github.com/froilanfulgencio/sdet-automation-challenge#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
